# Runtime mode used for safer production error responses.
NODE_ENV=development

# HTTP port. Defaults to 4000 when unset.
PORT=4000

# API docs at /api/docs. On in development. In production, set true and redeploy
# only while you need the docs, then set it back to false.
# SWAGGER_ENABLED=false

# Global API prefix from API.md. The starter GET / route stays at the root.
API_PREFIX=api/v1

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Reverse-proxy hops used for the rate-limit client address. Keep 0 in local
# development and whenever the API port is reachable directly. Set 1 only when
# every request comes through one proxy that appends the real client address
# (for example nginx `X-Forwarded-For $proxy_add_x_forwarded_for`) and clients
# cannot open the app port themselves. Do not set `true` or trust a raw header.
TRUSTED_PROXY_HOPS=0

# Days before a society invitation expires. Default 14. Allowed range 1–90.
# INVITATION_TTL_DAYS=14

# PostgreSQL for Prisma. Docker Compose maps host 5434 -> container 5432.
# Start with: npm run db:up   (or: docker compose up -d)
# Confirm with: docker ps  (look for livingspace-pg ports)
# Local compose defaults (not for production):
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/livingspace_dev

# Required for Prisma CLI even when only validating schema. prisma.config.ts
# loads this file automatically when present; otherwise export DATABASE_URL.

# Dedicated DB for `npm run test:integration` (must include livingspace_test, localhost only).
# Created by compose init SQL (fresh volume) or: npm run db:create-test
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5434/livingspace_test

# Supabase Auth (set both URL and anon key, or neither).
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_ISSUER=
# SUPABASE_JWT_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=

# Shared with the Next.js server (not a NEXT_PUBLIC_ variable).
# Required in production. Used only to record signup choices before a session exists.
# SIGNUP_INTENT_SECRET=

# Optional complaint image storage (default: disabled — uploads return 503).
# COMPLAINT_ATTACHMENT_STORAGE=disabled|local|memory
# COMPLAINT_ATTACHMENT_DIR=./storage/complaint-attachments
# Allowed types: image/jpeg, image/png, image/webp. Max 5MB, max 5 per complaint.
# Downloads are always auth-gated; never expose storage paths publicly.

# Optional contact-form email. Set all three, or leave all unset.
# Inquiries are stored either way. Email is sent through the Resend HTTPS API.
# MAIL_FROM must be a sender the provider has verified. Do not invent these values.
# SUPPORT_EMAIL=
# MAIL_FROM=
# RESEND_API_KEY=
